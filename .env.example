# Vercel Postgres connection string (used by Drizzle for migrations & queries).
# On Vercel this is provided automatically; locally, copy to .env and fill in.
POSTGRES_URL="postgresql://user:password@host:5432/database"

# Admin authentication.
# Secret for signing the admin session cookie — set a long random value.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
# Admin login. Either set ADMIN_PASSWORD (hashed at boot) or a precomputed
# ADMIN_PASSWORD_HASH ("saltHex:hashHex"). Dev default: admin@tpb.co.id / admin123.
ADMIN_EMAIL="admin@tpb.co.id"
ADMIN_PASSWORD="change-me"
